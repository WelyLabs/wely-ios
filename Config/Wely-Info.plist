<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Where the app talks to; set per configuration in the WELY_* build settings. -->
	<key>WelyGatewayURL</key>
	<string>$(WELY_GATEWAY_URL)</string>
	<key>WelyKeycloakURL</key>
	<string>$(WELY_KEYCLOAK_URL)</string>
	<key>WelyWebURL</key>
	<string>$(WELY_WEB_URL)</string>
	<!-- One Keycloak serves every environment, one realm each, with a client named after its
	     service and environment: neither can be a constant in the binary. -->
	<key>WelyKeycloakRealm</key>
	<string>$(WELY_KEYCLOAK_REALM)</string>
	<key>WelyKeycloakClientId</key>
	<string>$(WELY_KEYCLOAK_CLIENT_ID)</string>
	<!-- The local stack is plain HTTP on localhost / the LAN. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Asked by the Explore map, to centre it on the user. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Wely affiche ta position sur la carte pour te montrer les événements autour de toi.</string>
	<!-- Asked when the app lock is on (Preferences › Sécurité). -->
	<key>NSFaceIDUsageDescription</key>
	<string>Wely utilise Face ID pour se déverrouiller.</string>
	<!-- Asked when joining a call, and when turning the camera on in one. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Wely utilise le micro pendant les appels audio et vidéo.</string>
	<key>NSCameraUsageDescription</key>
	<string>Wely utilise la caméra pendant les appels vidéo.</string>
	<!-- A call keeps going when the screen locks or another app comes to the front; a VoIP
	     push wakes the app to ring an incoming call with CallKit. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>voip</string>
	</array>
	<!-- Outfit, wely-web's face (OFL-1.1, google/fonts), as one variable font. -->
	<key>UIAppFonts</key>
	<array>
		<string>Outfit.ttf</string>
	</array>
</dict>
</plist>
